# Copy this file to .env and fill in your own values. Never commit .env.

# MySQL connection string: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/community_store"

# Used to sign session tokens before they are stored. At least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Public base URL of the app (used in docs/Postman and by the frontend).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: bcrypt cost factor (default 12). Lower values are only for tests.
# BCRYPT_ROUNDS=12
