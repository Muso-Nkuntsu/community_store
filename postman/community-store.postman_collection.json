    {
      "name": "5. Get listings (page 1)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/listings?page=1&limit=12",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "listings"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "12"
            }
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "const me = pm.collectionVariables.get(\"userId\");",
              "const other = pm.response.json().items.find(l => l.seller.id !== me && l.isAvailable);",
              "if (other) pm.collectionVariables.set(\"otherListingId\", other.id);",
              "pm.test(\"Has pagination metadata\", () => pm.expect(pm.response.json()).to.include.keys(\"items\",\"page\",\"limit\",\"total\",\"totalPages\"));"
            ]
          }
        }
      ]
    },
