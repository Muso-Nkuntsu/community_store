{
  "info": {
    "name": "Community Store API",
    "description": "Run the requests in order (Collection Runner works). Auth uses an HttpOnly cookie: Postman's cookie jar keeps it after Login, so there are no tokens to paste. Seed the database first (npx prisma db seed). Set baseUrl if not http://localhost:3000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Register (new user)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "description": "Creates an account and logs it in (cookie set). Uses a random email each run.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Tester\",\n  \"email\": \"{{$randomEmail}}\",\n  \"password\": \"Password123!\",\n  \"confirmPassword\": \"Password123!\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Login (seeded user Thandi)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "description": "Postman stores the cs_session cookie automatically and sends it on later requests.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"thandi@communitystore.test\",\n  \"password\": \"Password123!\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"userId\", pm.response.json().user.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Get session",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/session",
