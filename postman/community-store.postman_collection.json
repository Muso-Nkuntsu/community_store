          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman test textbook\",\n  \"description\": \"Created from the Postman collection.\",\n  \"price\": \"199.99\",\n  \"category\": \"TEXTBOOKS\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
